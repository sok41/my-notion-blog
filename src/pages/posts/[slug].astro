---
import * as interfaces from '../../lib/interfaces.ts'
import Profile from '../../components/Profile.astro'

import {
  getPosts,
  getAllPosts,
  getRankedPosts,
  getPostBySlug,
  getPostsByTag,
  getBlock,
  getAllTags,
  getAllBlocksByBlockId,
  downloadFile,
  getDatabase,
} from '../../lib/notion/client.ts'
import {
  getPostLink,
  filePath,
  extractTargetBlocks,
} from '../../lib/blog-helpers.ts'
import Layout from '../../layouts/Layout.astro'
import PostDate from '../../components/PostDate.astro'
import PostTags from '../../components/PostTags.astro'
import PostTitle from '../../components/PostTitle.astro'
import PostBody from '../../components/PostBody.astro'
import PostRelativeLink from '../../components/PostRelativeLink.astro'
import BlogPostsLink from '../../components/BlogPostsLink.astro'
import BlogTagsLink from '../../components/BlogTagsLink.astro'
import styles from '../../styles/blog.module.css'

import LikeButton from '../../components/LikeButton.astro'

export async function getStaticPaths() {
  const posts = await getAllPosts()
  return posts.map((post: interfaces.Post) => ({ params: { slug: post.Slug } }))
}

const { slug } = Astro.params

const post = await getPostBySlug(slug)
if (!post) {
  throw new Error(`Post not found. slug: ${slug}`)
}

const [blocks, allPosts, rankedPosts, recentPosts, tags, postsHavingSameTag] =
  await Promise.all([
    getAllBlocksByBlockId(post.PageId),
    getAllPosts(),
    getRankedPosts(),
    getPosts(5),
    getAllTags(),
    getPostsByTag(post.Tags[0]?.name, 6),
  ])

const fileAtacchedBlocks = extractTargetBlocks('image', blocks)
  .concat(extractTargetBlocks('file', blocks))
  .filter((block) => {
    if (!block) {
      return false
    }
    const imageOrFile = block.Image || block.File
    return imageOrFile && imageOrFile.File && imageOrFile.File.Url
  })

// Download files
await Promise.all(
  fileAtacchedBlocks
    .map(async (block) => {
      const expiryTime = (block.Image || block.File).File.ExpiryTime
      if (Date.parse(expiryTime) > Date.now()) {
        return Promise.resolve(block)
      }
      return getBlock(block.Id)
    })
    .map((promise) =>
      promise.then((block) => {
        let url!: URL
        try {
          url = new URL((block.Image || block.File).File.Url)
        } catch {
          console.log('Invalid file URL: ', (block.Image || block.File)?.File?.Url)
          return Promise.reject()
        }
        return Promise.resolve(url)
      })
    )
    .map((promise) => promise.then(downloadFile))
)

const currentPostIndex = allPosts.findIndex((post) => post.Slug === slug)
const prevPost = allPosts[currentPostIndex + 1]
const nextPost = allPosts[currentPostIndex - 1]

const siteDomain = Astro.site ? Astro.site.toString() : Astro.url.origin

// 動的OG画像の絶対URLを生成
let ogImage = new URL(`/og/${slug}.png`, siteDomain).toString()

// ブログ名（データベース名）を取得
const database = await getDatabase()
const blogTitle = database?.Title || ''

// --- ▼ 構造化データ (JSON-LD) 用の変数を定義 ▼ ---
const postUrl = new URL(getPostLink(post.Slug), siteDomain).toString()
const publishedTime = post.Date ? new Date(post.Date).toISOString() : new SDate().toISOString()

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.Title,
  "description": post.Excerpt || blogTitle,
  "image": ogImage,
  "url": postUrl,
  "datePublished": publishedTime,
  "dateModified": publishedTime,
  "author": {
    "@type": "Person",
    "name": "sok41"
  },
  "publisher": {
    "@type": "Organization",
    "name": blogTitle || "My Blog",
    "logo": {
      "@type": "ImageObject",
      "url": new URL("/avatar.png", siteDomain).toString()
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": postUrl
  }
}
---

<Layout
  title={post.Title}
  description={post.Excerpt}
  path={getPostLink(post.Slug)}
  ogImage={ogImage}
  siteTitleHeading={false}
>
  <!-- ★ 構造化データの埋め込み -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />

  <div slot="main" class={styles.main}>
    <div class={styles.post}>
    <div class="post-meta">
      <PostDate post={post} />
      <PostTags post={post} />
    </div>
      <PostTitle post={post} enableLink={false} titleTag="h1" />
      <PostBody blocks={blocks} />

      <LikeButton slug={post.Slug} title={post.Title} blogTitle={blogTitle} />

      <footer>
        <PostRelativeLink prevPost={prevPost} nextPost={nextPost} />
      </footer>
    </div>
  </div>

  <div slot="aside" class="aside">

    <Profile />

    <BlogPostsLink
      heading="Posts in the same category"
      posts={postsHavingSameTag.filter(
        (p: interfaces.Post) => p.Slug !== post.Slug
      )}
    />
     
    <BlogPostsLink heading="Latest posts" posts={recentPosts} />
    <BlogTagsLink heading="Categories" tags={tags} />
  </div>

<style>
.post-meta {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-bottom: 0.5rem;
}
</style>

</Layout>