---
import { ENABLE_LIGHTBOX } from '../../server-constants.ts'
import * as interfaces from '../../lib/interfaces'
import { filePath } from '../../lib/blog-helpers'
import Caption from './Caption.astro'

export interface Props {
  block: interfaces.Block
}

const { block } = Astro.props

let image = ''
if (block.Image.External) {
  image = block.Image.External.Url
} else if (block.Image.File) {
  image = filePath(new URL(block.Image.File.Url))
}

// SEO/アクセシビリティ向上のため、Notion側で画像にキャプションが
// 設定されていればそれをaltテキストとして使う。なければ従来通りの
// 汎用テキストにフォールバックする。
const captionText = block.Image.Caption?.[0]?.PlainText?.trim()
const altText = captionText || 'Image in a image block'
---

<figure class="image">
  {
    image && (
      <div>
        <div>
          {ENABLE_LIGHTBOX ? (
            <a data-fslightbox href={image} data-type="image">
              <img src={image} alt={altText} loading="lazy" />
            </a>
          ) : (
            <img src={image} alt={altText} loading="lazy" />
          )}
        </div>
        <Caption richTexts={block.Image.Caption} />
      </div>
    )
  }
</figure>

<style>
  .image {
    display: flex;
    justify-content: center;
    margin: 0.9rem auto;
  }
  .image > div {
    margin: 0 auto;
  }
  .image > div > div {
  }
  .image > div > div img {
    display: block;
    /* 記事幅いっぱい(100%)まで広がると文章に対して大きすぎて見づらいため、
       記事幅の70%を上限にする。クリック前（ライトボックスを開く前）の
       プレビューが小さい画像は min-width で60%まで底上げしつつ、
       max-width 70% を超えては広がらないようにする。
       画像側の幅が%指定になったことで祖先divの中央寄せ(margin:auto)が
       効かなくなるため、img自体にも中央寄せを指定しておく。 */
    min-width: 60%;
    max-width: 70%;
    height: auto;
    margin: 0 auto;
  }
  .image > div > div a {
    cursor: zoom-in;
  }
</style>
