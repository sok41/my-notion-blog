---
import { Post } from '../lib/interfaces.ts'
import { getPostLink } from '../lib/blog-helpers.ts'

export interface Props {
  post: Post
  enableLink: boolean
  // 個別記事ページ（そのページの主題を表す唯一の見出し）では 'h1' を
  // 渡す。一覧・タグページなど複数記事を並べる場所では 'h2'（既定）
  // のまま。CSSはクラス（.post-title）指定のため見た目は変わらない。
  titleTag?: 'h1' | 'h2'
}

const { post, enableLink = true, titleTag = 'h2' } = Astro.props
const TitleTag = titleTag

let title = post.Title
---

<TitleTag class="post-title">
  {
    enableLink ? (
      <a href={getPostLink(post.Slug)}>
        {post.Icon && post.Icon.Type === 'emoji' ? (
          <>
            <span>{post.Icon.Emoji}</span>
            {title}
          </>
        ) : post.Icon && post.Icon.Type === 'external' ? (
          <>
            <img src={post.Icon.Url} alt="Post title icon" />
            {title}
          </>
        ) : (
          title
        )}
      </a>
    ) : (
      <>
        {post.Icon && post.Icon.Type === 'emoji' ? (
          <>
            <span>{post.Icon.Emoji}</span>
            {title}
          </>
        ) : post.Icon && post.Icon.Type === 'external' ? (
          <>
            <img src={post.Icon.Url} alt="Post title icon" />
            {title}
          </>
        ) : (
          title
        )}
      </>
    )
  }
</TitleTag>

<style>
  /* Blank Space: 色をほぼ使わず、線と余白と文字の太さだけで語るミニマル */
  .post-title {
    margin: 0;
    padding: 0.2rem 0;
    color: var(--fg);
  }
  .post-title a {
    color: inherit;
  }

  /* 個別記事ページの記事タイトル（h1） */
  h1.post-title {
    font-size: 2.1rem;
    font-weight: 300;
    line-height: 1.65;
    letter-spacing: 0.01em;
    text-wrap: balance;
  }

  /* トップページ・一覧の記事タイトル（h2） */
  h2.post-title {
    font-size: 1.08rem;
    font-weight: 400;
    line-height: 1.65;
  }
  h2.post-title a:hover {
    text-decoration: underline;
    text-decoration-color: currentColor;
    text-underline-offset: 3px;
  }

  .post-title span,
  .post-title img {
    display: inline-block;
    margin-right: 0.2em;
  }
  .post-title span {
    font-size: 1.2em;
  }
  .post-title img {
    width: 1.3em;
    height: 1.3em;
    vertical-align: sub;
  }
  @media (max-width: 640px) {
    h1.post-title {
      font-size: 1.55rem;
    }
    h2.post-title {
      font-size: 1rem;
    }
  }
</style>
