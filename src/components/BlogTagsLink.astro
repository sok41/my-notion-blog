---
import type { SelectProperty } from '../lib/interfaces.ts'
import { getTagLink } from '../lib/blog-helpers.ts'
import NoContents from './NoContents.astro'
import '../styles/notion-color.css'

export interface Props {
  heading: string
  tags: SelectProperty[]
}

const { heading, tags } = Astro.props
---

<div class="blog-tags-link">
  <h2>{heading}</h2>
  {
    tags.length === 0 ? (
      <NoContents contents={tags} />
    ) : (
      <ul>
        {tags.map((tag: SelectProperty) => (
          <li>
            <a href={getTagLink(tag.name)} class={`tag ${tag.color}`}>
              {tag.name}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</div>

<style>

/* コンテナ全体の余白 */
.blog-tags-link {
  margin-bottom: 2rem;
  padding: 0 0.5rem;
}

/* Notion風の見出し */
.blog-tags-link h2 {
  margin: 0 0 0.4rem 0;
  padding: 0;
  font-size: 0.85rem;
  font-weight: 600;
  color: #787774;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

/* タグ一覧のリスト（Flexboxで折り返し） */
.blog-tags-link ul,
.blog-tags-link div {
  display: flex;
  flex-wrap: wrap;
  gap: 0.25rem 0.35rem; /* [上下 左右] のコンパクトな隙間 */
  list-style: none;
  padding: 0;
  margin: 0;
}

/* リストアイテムの余白リセット */
.blog-tags-link li {
  margin: 0;
  padding: 0;
}

/* Notion風マルチセレクトタグ */
.blog-tags-link a {
  display: inline-flex;
  align-items: center;
  font-size: 0.78rem;
  padding: 0.15rem 0.45rem;
  border-radius: 4px;
  text-decoration: none;
  font-weight: 500;
  line-height: 1.2;
  white-space: nowrap; /* タグ内文字の改行防止 */
  transition: transform 0.1s ease, opacity 0.15s ease;
}

/* ホバー時の挙動 */
.blog-tags-link a:hover {
  opacity: 0.85;
  transform: translateY(-1px);
}

</style>
