---
import { Post } from '../lib/interfaces.ts'

export interface Props {
  post: Post
}

const { post } = Astro.props
---

<div class="post-excerpt">
  <p>{post.Excerpt ? post.Excerpt : ''}</p>
</div>

<style>
  .post-excerpt {
    padding: 0.35rem 0 0;
  }

  .post-excerpt p {
    margin: 0;
    font-size: 0.88rem;
    font-weight: 400;
    line-height: 1.75;
    color: #8a8a85;
  }
</style>
